{
  "name": "authoritative-game-server",
  "version": "1.0.0",
  "description": "Authoritative game server for an asymmetric real-world stealth game with Socket.IO and Redis ephemeral store",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
